# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# Temporary files, for example, from tests.
/tmp/

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Ignore package tarball (built via "mix hex.build").
ccxt_ocx-*.tar

# npm_ex installs node packages here — pulled by `mix deps.get` via npm.lock.
/node_modules/

# Hex docs cache (pulled on demand).
/.hex-docs/

# Compile-time per-exchange capability caches (populated lazily by
# ExchangeCaps.fetch_or_build/1 when Task 9 or manual probing runs; the
# verify-bundle Mix task will learn to refresh them on CCXT bumps).
/priv/exchange_caps/

# Dialyzer PLTs (per CLAUDE.md, kept out of _build to survive cleanup).
/priv/plts/

